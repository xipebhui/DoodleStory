      "approved_filename": "PC-S10-approved.png"
    },
    {
      "scene_id": "S11",
      "target_duration_seconds": 12,
      "han_characters": 46,
      "narration": "今天这些遗址在浅水下，不代表古人在水里煮盐。它们废弃后被海水淹没，缺氧泥炭反而保存了木柱和作业布局。",
      "fact_ids": ["F2"],
      "source_ids": ["S3", "S4", "S6"],
      "rights_ids": ["R2", "R3", "R7"],

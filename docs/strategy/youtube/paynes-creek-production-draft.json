  "scenes": [
    {
      "scene_id": "S01",
      "target_duration_seconds": 8,
      "han_characters": 34,
      "narration": "海岸生产的盐，怎样到达内陆？佩恩斯克里克留下了一条不完整、却能追踪的证据链。",
      "fact_ids": ["F8"],
      "source_ids": ["S1", "S4", "S5"],
      "rights_ids": ["R1", "R2", "R3"],
      "evidence_level": "B_interpretation",
      "motion_preset": "zoom_in",
      "prompt_heading": "S01｜海岸的盐怎样到达内陆",
      "expected_candidate_filename": "PC-S01-v01.png",
      "approved_filename": "PC-S01-approved.png"
    },
    {
      "scene_id": "S02",
      "target_duration_seconds": 10,
      "han_characters": 42,
      "narration": "它位于今天伯利兹南部海岸。考古年代显示，这套盐业系统的核心活动，大约发生在公元六百到九百年。",
      "fact_ids": ["F1"],
      "source_ids": ["S1", "S3", "S4"],
      "rights_ids": ["R1", "R2", "R3"],
      "evidence_level": "A_direct",
      "motion_preset": "static",
      "prompt_heading": "S02｜时间与地点",
      "expected_candidate_filename": "PC-S02-v01.png",
      "approved_filename": "PC-S02-approved.png"
    },
    {
      "scene_id": "S03",
      "target_duration_seconds": 11,
      "han_characters": 44,
      "narration": "下面这一步，是依据遗迹和类比做的重建：盐工可能让盐水经过含盐土，提高浓度，再把更浓的卤水收进陶罐。",
      "fact_ids": ["F3"],
      "source_ids": ["S3", "S4"],
      "rights_ids": ["R2", "R3"],
      "evidence_level": "A_plus_B_reconstruction",
      "motion_preset": "pan_right",
      "prompt_heading": "S03｜依据遗迹与类比重建浓缩步骤",
      "expected_candidate_filename": "PC-S03-v01.png",
      "approved_filename": "PC-S03-approved.png"
    },
    {
      "scene_id": "S04",
      "target_duration_seconds": 12,
      "han_characters": 43,
      "narration": "接着，陶碗、陶罐或陶盆被黏土支座托在火上。器物与支座的组合，支持人们在这里加热卤水，让盐逐渐结晶。",
      "fact_ids": ["F3"],
      "source_ids": ["S1", "S3", "S4"],
      "rights_ids": ["R2", "R3"],
      "evidence_level": "A_plus_B_chain",
      "motion_preset": "zoom_in",
      "prompt_heading": "S04｜陶器与黏土支座加热卤水",
      "expected_candidate_filename": "PC-S04-v01.png",
      "approved_filename": "PC-S04-approved.png"
    },
    {
      "scene_id": "S05",
      "target_duration_seconds": 13,
      "han_characters": 48,
      "narration": "木柱布局还显示，盐厨房与居住空间彼此相邻。这支持家庭或亲属群体参与剩余生产，但我们不知道具体家谱和分工。",
      "fact_ids": ["F5"],
      "source_ids": ["S3", "S4"],
      "rights_ids": ["R2", "R3"],
      "evidence_level": "A_plus_B_chain",
      "motion_preset": "pan_down",
      "prompt_heading": "S05｜居住空间与盐厨房相邻",
      "expected_candidate_filename": "PC-S05-v01.png",
      "approved_filename": "PC-S05-approved.png"
    },
    {
      "scene_id": "S06",
      "target_duration_seconds": 14,
      "han_characters": 51,
      "narration": "这里也不像偶尔为一户人家煮一锅盐。大量制盐粗陶和专门作业空间，共同支持超过日常自用的生产；确切年产量仍不知道。",
      "fact_ids": ["F4"],
      "source_ids": ["S1", "S3", "S4"],
      "rights_ids": ["R2", "R3"],
      "evidence_level": "A_plus_B_chain",
      "motion_preset": "zoom_out",
      "prompt_heading": "S06｜证据支持超过日常自用的生产",
      "expected_candidate_filename": "PC-S06-v01.png",
      "approved_filename": "PC-S06-approved.png"
    },
    {
      "scene_id": "S07",
      "target_duration_seconds": 11,
      "han_characters": 44,
      "narration": "成品可以是散盐。相近的器形还支持制作尺寸相近盐饼的可能，但这不等于玛雅人已经把盐当成通用货币。",
      "fact_ids": ["F6"],
      "source_ids": ["S4", "S5"],
      "rights_ids": ["R3", "R6"],
      "evidence_level": "B_interpretation",
      "motion_preset": "static",
      "prompt_heading": "S07｜散盐与可能的盐饼",
      "expected_candidate_filename": "PC-S07-v01.png",
      "approved_filename": "PC-S07-approved.png"

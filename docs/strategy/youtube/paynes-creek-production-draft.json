    {
      "scene_id": "S08",
      "target_duration_seconds": 11,
      "han_characters": 44,
      "narration": "运输链里最直接的证据，是盐业遗址出土的一支全尺寸木桨，长约一米四三。它证明这里具备水上交通能力。",
      "fact_ids": ["F7"],

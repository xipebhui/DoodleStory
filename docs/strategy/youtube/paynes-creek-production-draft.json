      "rights_ids": ["R4"],
      "evidence_level": "A_direct",
      "motion_preset": "zoom_out",
      "prompt_heading": "S08｜全尺寸木桨是直接证据",
      "expected_candidate_filename": "PC-S08-v01.png",
      "approved_filename": "PC-S08-approved.png"
    },
    {
      "scene_id": "S09",
      "target_duration_seconds": 12,
      "han_characters": 46,
      "narration": "船桨与当地舟船技术，让独木舟运输成为合理解释；但考古没有留下某一条船的货单，我们不知道它装了多少盐。",
      "fact_ids": ["F7", "F8"],
      "source_ids": ["S1", "S4"],
      "rights_ids": ["R2", "R4"],
      "evidence_level": "A_plus_B_interpretation",

      "prompt_heading": "S09｜独木舟运输合理，但没有货单",
      "expected_candidate_filename": "PC-S09-v01.png",
      "approved_filename": "PC-S09-approved.png"
    },
    {
      "scene_id": "S10",
      "target_duration_seconds": 11,
      "han_characters": 43,
      "narration": "生产规模、船桨和沿海与内陆的物质联系，共同支持盐进入内陆交换网络；具体路线、城市和买家仍然未知。",
      "fact_ids": ["F8"],
      "source_ids": ["S1", "S4", "S5"],
      "rights_ids": ["R1", "R3", "R4", "R6"],
      "evidence_level": "B_interpretation",
      "motion_preset": "static",
      "prompt_heading": "S10｜内陆方向网络不是确定路线",

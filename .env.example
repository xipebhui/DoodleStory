# Copy to .env and fill the values your project needs.

APP_ENV=development
DATABASE_URL=sqlite:///./doodlestory.db
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=
# Production Docker image serves Vite build output from this directory.
# Leave empty for local split frontend/backend development.
DOODLESTORY_FRONTEND_DIST=
STORAGE_BACKEND=local
DOODLESTORY_STORAGE_ROOT=./storage
# Object storage uploads remove the temporary local mirror by default.
# Set true only when the server must keep a full local mirror for offline processing.
OBJECT_STORAGE_KEEP_LOCAL_MIRROR=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_BUCKET_DOMAIN=
# Existing deployments may use QNY_* aliases instead:
# QNY_ACCESS_KEY=
# QNY_SECRET_KEY=
# QNY_BUCKET=
# QNY_PUBLIC_BASE_URL=
# QNY_USE_HTTPS=true
# QNY_DOMAIN=
QINIU_THUMBNAIL_FOP=imageView2/1/w/320/h/568/format/webp/q/75
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
# Optional custom public base URL. Leave empty to use https://<bucket>.<endpoint-host>.
ALIYUN_OSS_PUBLIC_BASE_URL=
LOCAL_THUMBNAIL_WIDTH=320
LOCAL_THUMBNAIL_HEIGHT=568
# Multiple frontend origins can be separated by commas, for example:
# FRONTEND_ORIGIN=http://127.0.0.1:3000,http://8.141.96.236:3000
FRONTEND_ORIGIN=http://127.0.0.1:3000
VITE_API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_TEMPERATURE=0.8
CHARACTER_EXTRACTION_MODEL=deepseek-ai/DeepSeek-V3.2
CHARACTER_EXTRACTION_TEMPERATURE=0.1

LIO_API_KEY=
LIO_BASE_URL=
LIO_MODEL=gemini-3.1-flash-lite-preview-thinking-minimal

# The current production value points to Huomiao and is the primary provider for single-image content extraction.
TEXT_FALLBACK_API_KEY=
TEXT_FALLBACK_BASE_URL=
TEXT_FALLBACK_MODEL=gpt-5.4
AGENT_MODEL=gpt-5.5
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_PRIMARY_RETRY_ATTEMPTS=1
AGENT_RETRY_BACKOFF_SECONDS=0.5
AGENT_WORKER_CONCURRENCY=1
AGENT_CONTEXT_MESSAGE_LIMIT=200
# Agent MLflow tracing is opt-in. When enabled, use an HTTP(S) Tracking Server.
# Local example: http://127.0.0.1:5000 (see README for the server command).
MLFLOW_TRACING_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=doodlestory-agent-local
# false records IDs, routing, latency and usage, but not user text, prompts or provider payloads.
MLFLOW_TRACE_CONTENT=false

# Native Agent fixed Volcengine/Doubao speech Tool.
# DOUBAO_VOICE_GEN_AK is the speech-console Access Token used by X-Api-Access-Key.
# DOUBAO_VOICE_GEN_SK is retained with the console credential set but is not sent
# to the V3 unidirectional TTS endpoint.
DOUBAO_VOICE_GEN_APPID=
DOUBAO_VOICE_GEN_AK=
DOUBAO_VOICE_GEN_SK=
DOUBAO_VOICE_GEN_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_VOICE_GEN_RESOURCE_ID=seed-tts-2.0
DOUBAO_VOICE_GEN_MODEL=seed-tts-2.0-standard
DOUBAO_VOICE_GEN_SPEAKER=zh_female_xinlingjitang_uranus_bigtts
DOUBAO_VOICE_GEN_FORMAT=mp3
DOUBAO_VOICE_GEN_SAMPLE_RATE=24000
DOUBAO_VOICE_GEN_SPEECH_RATE=0
DOUBAO_VOICE_GEN_LOUDNESS_RATE=0
DOUBAO_VOICE_GEN_TIMEOUT_SECONDS=120
FFPROBE_EXECUTABLE=ffprobe
REMOTION_PROJECT_DIR=remotion
REMOTION_NODE_EXECUTABLE=node
REMOTION_RENDER_TIMEOUT_SECONDS=1200

IMAGE_GATEWAY_API_KEY=
IMAGE_GATEWAY_BASE_URL=http://192.129.209.36:3001/v1
# Explicit image provider switch. qy uses IMAGE_GATEWAY_*; xgapi uses XG_*.
# This is not a fallback. The selected provider is the only image provider used.
IMAGE_PROVIDER=qy
XG_BASE_URL=https://api.xgapi.top
XG_API_KEY=
XG_IMAGE_MODEL=gemini-3.1-flash-image-preview
XG_IMAGE_QUALITY=1k

APEXERAPI_BASE=https://www.aiapexers.com/
APEXERAPI_API_KEY=
# Optional. Only ApexerAPI chat image generation requests use this proxy.
APEXERAPI_PROXY_URL=
XG_REQUEST_MAX_ATTEMPTS=3
XG_REQUEST_RETRY_BACKOFF_SECONDS=2
IMAGE_PROVIDER_TIMEOUT_RETRY_ATTEMPTS=3
TASK_WORKER_CONCURRENCY=3
# Image provider calls are scheduled as generated_images jobs.
# Global concurrent image jobs. Default: 6.
IMAGE_JOB_CONCURRENCY=6
# Per-user concurrent image jobs. Default: 2.
IMAGE_JOB_USER_CONCURRENCY=2
# Running image jobs are re-queued after backend restart or lease expiry.
IMAGE_JOB_LEASE_SECONDS=1800
IMAGE_PROVIDER_DEBUG_LOG_RAW_IO=false
IMAGE_PROVIDER_DEBUG_LOG_RAW_MAX_CHARS=20000

# Content extraction integration.
# The frontend calls DoodleStory; only the backend calls this local service.
# Local non-Docker development usually uses http://127.0.0.1:8010.
# Docker Compose uses the internal multi-platform import service at
# http://douyin-import-service:8010 (Douyin download + WeChat article import).
DOUYIN_IMPORT_SERVICE_BASE_URL=http://127.0.0.1:8010
# Gallery content extraction sends one public image URL per request. If TEXT_FALLBACK_* fails,
# the same image switches to LIO_* for at most 3 attempts before the extraction fails.
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
SILICONFLOW_AUDIO_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct

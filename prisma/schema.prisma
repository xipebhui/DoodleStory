generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id                  String           @id @default(cuid())
  authUserId          String           @unique
  authUser            User             @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  email               String           @unique
  displayName         String?
  role                UserRole         @default(user)
  authProviderSubject String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tasks               GenerationTask[]

  @@index([role, createdAt])
}

model Style {
  id                   String                @id @default(cuid())
  name                 String                @unique
  description          String?
  status               StyleStatus           @default(draft)
  generationProfileKey String?
  stylePrompt          String
  lastTestedAt         DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  referenceImages      StyleReferenceImage[]
  styleTests           StyleTest[]
  tasks                GenerationTask[]

  @@index([status, updatedAt])
  @@index([generationProfileKey])
}

model FileAsset {
  id                    String                @id @default(cuid())
  purpose               FileAssetPurpose
  storageKey            String                @unique
  originalFilename      String?
  contentType           String
  byteSize              Int
  checksumSha256        String?
  width                 Int?
  height                Int?
  createdAt             DateTime              @default(now())
  styleReferenceImages  StyleReferenceImage[]
  styleTestOutputs      StyleTest[]           @relation("StyleTestOutput")
  generatedImages       GeneratedImage[]
  taskDownloads         TaskDownload[]

  @@index([purpose, createdAt])
}

model StyleReferenceImage {
  id           String    @id @default(cuid())
  styleId      String
  assetId      String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  style        Style     @relation(fields: [styleId], references: [id], onDelete: Cascade)
  asset        FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([styleId, assetId])
  @@index([styleId, displayOrder, createdAt])
}

model StyleTest {
  id                           String             @id @default(cuid())
  styleId                      String
  style                        Style              @relation(fields: [styleId], references: [id], onDelete: Restrict)
  testText                     String
  stylePromptSnapshot          String
  generationProfileKeySnapshot String?
  composedPrompt               String
  status                       WorkflowStatus     @default(queued)
  attempts                     Int                @default(0)
  maxAttempts                  Int                @default(3)
  nextRunAt                    DateTime?
  cancelRequestedAt            DateTime?
  startedAt                    DateTime?
  finishedAt                   DateTime?
  outputAssetId                String?
  outputAsset                  FileAsset?         @relation("StyleTestOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  providerRequestId            String?
  errorCode                    String?
  errorMessage                 String?
  internalErrorRef             String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  @@index([styleId, createdAt])
  @@index([status, nextRunAt])
}

model GenerationTask {
  id                           String             @id @default(cuid())
  ownerUserId                  String
  owner                        UserProfile        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  displayTitle                 String
  originalText                 String
  imageCountMode               ImageCountMode
  requestedImageCount          Int?
  styleId                      String
  style                        Style              @relation(fields: [styleId], references: [id], onDelete: Restrict)
  styleNameSnapshot            String
  stylePromptSnapshot          String
  generationProfileKeySnapshot String?
  status                       TaskStatus         @default(queued)
  currentStep                  GenerationStepName?
  progressCurrent              Int                @default(0)
  progressTotal                Int                @default(0)
  attempts                     Int                @default(0)
  maxAttempts                  Int                @default(3)
  nextRunAt                    DateTime?
  cancelRequestedAt            DateTime?
  startedAt                    DateTime?
  finishedAt                   DateTime?
  errorCode                    String?
  errorMessage                 String?
  internalErrorRef             String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  steps                        GenerationStep[]
  panels                       TaskPanel[]
  generatedImages              GeneratedImage[]
  downloads                    TaskDownload[]

  @@index([status, nextRunAt])
  @@index([status, updatedAt])
  @@index([styleId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([createdAt])
}

model GenerationStep {
  id               String             @id @default(cuid())
  taskId           String
  task             GenerationTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepName         GenerationStepName
  status           StepStatus         @default(queued)
  attempts         Int                @default(0)
  idempotencyKey   String             @unique
  startedAt        DateTime?
  finishedAt       DateTime?
  outputRef        String?
  errorCode        String?
  errorMessage     String?
  internalErrorRef String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([taskId, createdAt])
  @@index([status, updatedAt])
}

model TaskPanel {
  id                  String          @id @default(cuid())
  taskId              String
  task                GenerationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  panelOrder          Int
  originalTextSegment String
  promptStatus        PromptStatus    @default(pending)
  generatedPrompt     String?
  promptModelSnapshot String?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  generatedImage      GeneratedImage?

  @@unique([taskId, panelOrder])
  @@index([taskId, panelOrder])
}

model GeneratedImage {
  id                           String               @id @default(cuid())
  taskId                       String
  task                         GenerationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  panelId                      String               @unique
  panel                        TaskPanel            @relation(fields: [panelId], references: [id], onDelete: Cascade)
  status                       GeneratedImageStatus @default(queued)
  finalPrompt                  String
  generationProfileKeySnapshot String?
  assetId                      String?
  asset                        FileAsset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  providerRequestId            String?
  startedAt                    DateTime?
  finishedAt                   DateTime?
  errorCode                    String?
  errorMessage                 String?
  internalErrorRef             String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@index([taskId, createdAt])
  @@index([panelId])
  @@index([status, updatedAt])
}

model TaskDownload {
  id               String             @id @default(cuid())
  taskId           String
  task             GenerationTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status           DownloadStatus     @default(queued)
  imageCount       Int                @default(0)
  assetId          String?
  asset            FileAsset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  filename         String
  errorCode        String?
  errorMessage     String?
  internalErrorRef String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([taskId, createdAt])
}

enum UserRole {
  user
  admin
}

enum StyleStatus {
  draft
  active
  disabled
}

enum FileAssetPurpose {
  style_reference
  generated_image
  download_archive
}

enum WorkflowStatus {
  queued
  running
  succeeded
  failed
  cancel_requested
  cancelled
  retrying
}

enum ImageCountMode {
  auto
  fixed
}

enum TaskStatus {
  queued
  running
  succeeded
  partial_succeeded
  failed
  cancel_requested
  cancelled
  retrying
}

enum GenerationStepName {
  segment_story
  generate_panel_prompts
  generate_images
  package_download
}

enum StepStatus {
  queued
  running
  succeeded
  failed
  cancelled
  retrying
}

enum PromptStatus {
  pending
  generated
  failed
}

enum GeneratedImageStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum DownloadStatus {
  queued
  running
  ready
  failed
}
